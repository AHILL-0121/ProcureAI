# Copy to backend/.env.local (or .env) and fill in. Real environment variables override these files.

# ─── App ───────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_PORT=8001
CORS_ORIGINS=http://localhost:3000  # comma-separated list of frontend origins

# ─── Database (required) ──────────────────────────────
# Your Neon PostgreSQL connection string (Neon console → Connection details). No local database is used.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# ─── Groq (required for reading invoices) ─────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.8-27b   # empty disables the vision fallback
LLM_STARTUP_CHECK=true              # on start, send one tiny request to each model and log whether it answers

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production  # required in production: a long random string
ADMIN_EMAIL=                        # first admin, created when no users exist
ADMIN_PASSWORD=                     # (development falls back to admin@procureai.local / procureai-admin)

# ─── Matching defaults (per-vendor overrides live in Settings) ─
TOLERANCE_QTY_PCT=0.02
TOLERANCE_PRICE_PCT=0.05
TOLERANCE_PRICE_ABS=0.05
TOLERANCE_TOTAL_ABS=1.00
REVIEW_CONFIDENCE_THRESHOLD=0.6
MATCH_INCLUDE_ERP_INVOICE_HISTORY=false
ERP_SAMPLE_DATA=true                # false: start empty and import your own ERP data in Settings

# ─── Uploads & processing ─────────────────────────────
UPLOAD_MAX_BYTES=15728640
UPLOAD_RATE_PER_MINUTE=30
WORKER_CONCURRENCY=2

# ─── Email intake (optional) ──────────────────────────
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASSWORD=                     # use an app password for Gmail
EMAIL_USE_SSL=true
EMAIL_POLLING_ENABLED=true
EMAIL_POLL_INTERVAL=30
